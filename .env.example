# =====================================================================
# Retrieval-as-a-Guardrail Environment Configuration (.env)
# =====================================================================
# Copy this file to '.env' and add your API key if you want to test
# live LLM fallback on Route B / Route C queries.
#
# Note: The system runs 100% OFFLINE on Route A (0 LLM calls required).
# =====================================================================

# LLM Provider: 'anthropic' or 'openai' (Default: 'anthropic')
# GUARDRAIL_LLM_PROVIDER=anthropic

# Anthropic API Key (Starts with sk-ant-...)
ANTHROPIC_API_KEY=

# OpenAI API Key (Starts with sk-...)
OPENAI_API_KEY=

# Execution Mode: 'auto', 'replay', 'live', 'off' (Default: 'auto')
# auto   -> Replay recorded cache if available, else make live API call
# replay -> Only replay recorded cache (0 API calls, 100% offline)
# live   -> Always make live API call
# off    -> Disable LLM fallback completely
GUARDRAIL_LLM=auto

# Optional Custom Base URLs (e.g., for local proxy or enterprise endpoints)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com
