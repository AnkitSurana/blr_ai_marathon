# ==============================================================
# Retrieval as a Guardrail · .gitignore
# ==============================================================

# ---- Python bytecode & caches ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Packaging / build artifacts ----
build/
dist/
*.egg-info/
*.egg
.Python
pip-wheel-metadata/
.installed.cfg
MANIFEST

# ---- Test / lint caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key
*.pem

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# ---- Claude Code local session config ----
.claude/

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Runtime data files (regenerated by the app) ----
# The SQLite dataset itself is committed (data/olist_seller.sqlite).
# These three are per-session state.
data/audit.jsonl
data/review_queue.jsonl
data/llm_cache.jsonl

# ---- uv lockfile (comment out this line if you want to commit it) ----
# uv.lock

# ---- Scratch / temporary ----
scratchpad/
/tmp/
*.tmp
*.log

# ---- Node (in case any tooling ever lands here) ----
node_modules/

